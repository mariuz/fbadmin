<!--
  MSI of the fbadmin server edition for Windows Server (issue #11; WiX Toolset v5: `dotnet tool install -g wix`).

    wix build packaging/windows/server/fbadmin-server.wxs -arch x64 -wx ^
        -d SourceDir=%CD%\dist\fbadmin-server -d WinSW=%CD%\build\WinSW-x64.exe -d Version=2.2.0 ^
        -o dist\fbadmin-server-2.2.0-x64.msi

  SourceDir: the headless PyInstaller build (packaging/pyinstaller/fbadmin-server.spec), ABSOLUTE path.
  WinSW: WinSW-x64.exe v2 (https://github.com/winsw/winsw), installed as fbadmin-service.exe.

  It installs into Program Files\fbadmin-server and registers the service "fbadmin" (automatic start,
  account NT SERVICE\fbadmin: a virtual account, no password to manage), started at the end of the
  install. Settings and data are in %ProgramData%\fbadmin (fbadmin.toml, servers, keys, history, logs):
  kept on upgrade and on uninstall; only SYSTEM, Administrators and the service can open them.

  Silent install, e.g. with GPO / Intune / SCCM:
    msiexec /i fbadmin-server-2.2.0-x64.msi /qn PORT=5050 HOST=0.0.0.0 FIREWALL=1 ^
        SERVER_MODE=1 ADMIN_USER=admin ADMIN_PASSWORD=... CERTFILE=C:\tls\fbadmin.crt KEYFILE=C:\tls\fbadmin.key
  PORT, HOST, SERVER_MODE (1 or 0), CERTFILE, KEYFILE: written into fbadmin.toml when given (an upgrade without
  them keeps the file as it is).
  ADMIN_USER (default admin), ADMIN_EMAIL, ADMIN_PASSWORD: the first administrator of server mode. They go into a
  one-time file, initial-admin.ini in the data directory, which fbadmin reads at its first start and deletes once
  the account exists; an install where accounts exist already changes nothing. ADMIN_PASSWORD is hidden in MSI logs.
  FIREWALL=1: an inbound Windows Firewall rule "fbadmin" for the port (removed on uninstall).
  It is not code-signed unless the release workflow has a certificate (docs/PACKAGING.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="fbadmin Server" Manufacturer="fbadmin contributors" Version="$(Version)"
           UpgradeCode="0b9d2f6e-7c1a-4e55-9d3b-5a8e1c2f4b71" Scope="perMachine" InstallerVersion="500">
    <!-- AllowSameVersionUpgrades: a rebuilt package of the same version (CI, a fixed build) replaces the installed one
         instead of being installed next to it -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of fbadmin Server is already installed." AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="fbadmin.ico" SourceFile="packaging\icons\fbadmin.ico" />
    <Property Id="ARPPRODUCTICON" Value="fbadmin.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mariuz/fbadmin" />
    <Property Id="ARPCOMMENTS" Value="Web administration for Firebird SQL, as a Windows service" />

    <!-- command-line properties (Secure: also passed on to the installing service in managed installs) -->
    <Property Id="PORT" Secure="yes" />
    <Property Id="HOST" Secure="yes" />
    <Property Id="FIREWALL" Secure="yes" />
    <Property Id="SERVER_MODE" Secure="yes" />
    <Property Id="CERTFILE" Secure="yes" />
    <Property Id="KEYFILE" Secure="yes" />
    <Property Id="ADMIN_USER" Secure="yes" />
    <Property Id="ADMIN_EMAIL" Secure="yes" />
    <Property Id="ADMIN_PASSWORD" Secure="yes" Hidden="yes" />
    <!-- server_mode as TOML: 1, true or yes turn it on, anything else off -->
    <Property Id="SERVERMODEVAL" Value="false" />
    <SetProperty Id="SERVERMODEVAL" Value="true" After="CostFinalize" Sequence="execute"
                 Condition="SERVER_MODE=&quot;1&quot; OR SERVER_MODE~=&quot;true&quot; OR SERVER_MODE~=&quot;yes&quot;" />
    <Property Id="ADMINUSERVAL" Value="admin" />
    <SetProperty Id="ADMINUSERVAL" Value="[ADMIN_USER]" After="CostFinalize" Condition="ADMIN_USER" Sequence="execute" />

    <!-- the firewall rule's port: PORT when given, else the default -->
    <Property Id="FWPORT" Value="5050" />
    <SetProperty Id="FWPORT" Value="[PORT]" After="CostFinalize" Condition="PORT" Sequence="execute" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="fbadmin-server">
        <Files Include="$(SourceDir)\**" />
        <Component Id="Service">
          <File Id="WinSW" Source="$(WinSW)" Name="fbadmin-service.exe" KeyPath="yes" />
          <File Id="WinSWConfig" Source="packaging\windows\server\fbadmin-service.xml" Name="fbadmin-service.xml" />
          <ServiceInstall Id="fbadminService" Name="fbadmin" DisplayName="fbadmin (Firebird administration)"
                          Description="fbadmin web administration for Firebird SQL. Settings: %ProgramData%\fbadmin\fbadmin.toml"
                          Type="ownProcess" Start="auto" ErrorControl="normal" Account="NT SERVICE\fbadmin" Vital="yes" />
          <ServiceControl Id="fbadminServiceControl" Name="fbadmin" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          <!-- the event log source WinSW writes to (a virtual account may not create one) -->
          <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\fbadmin">
            <RegistryValue Name="EventMessageFile" Type="expandable" Value="%SystemRoot%\Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
          </RegistryKey>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="fbadmin">
        <!-- the default settings: installed once, never overwritten, kept on uninstall -->
        <Component Id="ConfigFile" NeverOverwrite="yes" Permanent="yes">
          <File Id="fbadminToml" Source="packaging\windows\server\fbadmin.toml" Name="fbadmin.toml" KeyPath="yes" />
        </Component>
        <Component Id="ConfigPort" Condition="PORT" Permanent="yes">
          <IniFile Id="PortValue" Action="addLine" Directory="DATAFOLDER" Name="fbadmin.toml" Section="server" Key="port" Value="[PORT]" />
          <RegistryValue Root="HKLM" Key="Software\fbadmin-server" Name="port" Type="string" Value="[PORT]" KeyPath="yes" />
        </Component>
        <Component Id="ConfigHost" Condition="HOST" Permanent="yes">
          <IniFile Id="HostValue" Action="addLine" Directory="DATAFOLDER" Name="fbadmin.toml" Section="server" Key="host" Value="&quot;[HOST]&quot;" />
          <RegistryValue Root="HKLM" Key="Software\fbadmin-server" Name="host" Type="string" Value="[HOST]" KeyPath="yes" />
        </Component>
        <Component Id="ConfigServerMode" Condition="SERVER_MODE" Permanent="yes">
          <IniFile Id="ServerModeValue" Action="addLine" Directory="DATAFOLDER" Name="fbadmin.toml" Section="server" Key="server_mode" Value="[SERVERMODEVAL]" />
          <RegistryValue Root="HKLM" Key="Software\fbadmin-server" Name="server_mode" Type="string" Value="[SERVERMODEVAL]" KeyPath="yes" />
        </Component>
        <!-- TOML literal strings ('...'): backslashes of Windows paths stay as they are -->
        <Component Id="ConfigCertFile" Condition="CERTFILE" Permanent="yes">
          <IniFile Id="CertFileValue" Action="addLine" Directory="DATAFOLDER" Name="fbadmin.toml" Section="server" Key="ssl_certfile" Value="'[CERTFILE]'" />
          <RegistryValue Root="HKLM" Key="Software\fbadmin-server" Name="ssl_certfile" Type="string" Value="[CERTFILE]" KeyPath="yes" />
        </Component>
        <Component Id="ConfigKeyFile" Condition="KEYFILE" Permanent="yes">
          <IniFile Id="KeyFileValue" Action="addLine" Directory="DATAFOLDER" Name="fbadmin.toml" Section="server" Key="ssl_keyfile" Value="'[KEYFILE]'" />
          <RegistryValue Root="HKLM" Key="Software\fbadmin-server" Name="ssl_keyfile" Type="string" Value="[KEYFILE]" KeyPath="yes" />
        </Component>
        <!-- the first administrator: a one-time file (written by the WriteAdminFile action below) that fbadmin
             deletes once the account exists; here only its name goes into fbadmin.toml -->
        <Component Id="AdminFile" Condition="ADMIN_PASSWORD" Permanent="yes">
          <IniFile Id="AdminFileSetting" Action="addLine" Directory="DATAFOLDER" Name="fbadmin.toml" Section="server" Key="admin_file" Value="&quot;initial-admin.ini&quot;" />
          <RegistryValue Root="HKLM" Key="Software\fbadmin-server" Name="admin_file" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- After the service exists (its virtual account can be named only then) and before it starts: only
         SYSTEM (S-1-5-18), Administrators (S-1-5-32-544) and the service may open the data directory, which
         holds saved passwords and keys (ProgramData lets every user read by default). Set on the folder only:
         Windows passes the inheritable entries on to the files in it (fbadmin.toml) and to new ones; /T would
         also strip the files' inherited entries, leaving fbadmin.toml readable by nobody. -->
    <!-- Before the settings (and the administrator file) are written: SYSTEM and Administrators only; a new
         folder in ProgramData would otherwise be readable by every user for a moment. -->
    <CustomAction Id="LockDataFolder" Directory="DATAFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[System64Folder]icacls.exe&quot; &quot;[DATAFOLDER].&quot; /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F /Q" />
    <!-- The administrator file, written by the installed program (fbadmin/admin_file.py): MSI's IniFile action would
         log the password; this command line is hidden in the log (HideTarget), and the password is read from it
         literally (everything after \-\-password=). -->
    <CustomAction Id="WriteAdminFile" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="check" HideTarget="yes"
                  ExeCommand="&quot;[INSTALLFOLDER]fbadmin-server.exe&quot; write-admin-file &quot;[DATAFOLDER]initial-admin.ini&quot; --user=[ADMINUSERVAL] --email=[ADMIN_EMAIL] --password=[ADMIN_PASSWORD]" />
    <CustomAction Id="SecureDataFolder" Directory="DATAFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[System64Folder]icacls.exe&quot; &quot;[DATAFOLDER].&quot; /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F &quot;NT SERVICE\fbadmin:(OI)(CI)M&quot; /Q" />
    <CustomAction Id="AddFirewallRule" Directory="DATAFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall add rule name=fbadmin dir=in action=allow protocol=TCP localport=[FWPORT]" />
    <CustomAction Id="RemoveFirewallRule" Directory="DATAFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]netsh.exe&quot; advfirewall firewall delete rule name=fbadmin" />
    <InstallExecuteSequence>
      <Custom Action="LockDataFolder" Before="WriteIniValues" Condition="NOT REMOVE" />
      <Custom Action="WriteAdminFile" After="LockDataFolder" Condition="ADMIN_PASSWORD AND NOT REMOVE" />
      <Custom Action="SecureDataFolder" After="InstallServices" Condition="NOT REMOVE" />
      <!-- before adding it again (no duplicates), and on uninstall; not when an upgrade removes the old version -->
      <Custom Action="RemoveFirewallRule" After="SecureDataFolder"
              Condition="(FIREWALL=&quot;1&quot; AND NOT REMOVE) OR (REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)" />
      <Custom Action="AddFirewallRule" After="RemoveFirewallRule" Condition="FIREWALL=&quot;1&quot; AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
